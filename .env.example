# Copy to .env and fill in real values. .env is gitignored - never commit real credentials.

# Airtable personal access token (starts with "pat"). Needs the data.records:read scope, plus
# data.records:write if you use the contact/feedback forms, and the base below must be added to
# the token's access list. Create/rotate at https://airtable.com/create/tokens
AIRTABLE_API_KEY=

# Base id, taken from the base URL: https://airtable.com/appXXXXXXXXXXXXXX/...
AIRTABLE_BASE_ID=

# Camps table. Accepts either the table name or its id (tblXXXXXXXXXXXXXX).
# Optional - defaults to "Camps".
AIRTABLE_TABLE_NAME=Camps

# Used by express-session.
SESSION_SECRET=

# After rotating AIRTABLE_API_KEY, update it here *and* in every deployment environment
# (e.g. Vercel project settings), then redeploy. Verify with:
#   curl -s https://<your-host>/api/health?airtable=1
